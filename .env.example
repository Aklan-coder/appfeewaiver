# Copy this file to `.env` and fill in the values.  NEVER commit `.env` to GitHub.

# --- Local development -------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Leave DATABASE_URL empty to use the local SQLite file (db.sqlite3).
# For PostgreSQL:  postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DB_SSL_REQUIRE=False

# Emails print in the terminal while developing.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Production (example values; set these in your host's dashboard) ---------
# DEBUG=False
# SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=appfeewaiver.com,www.appfeewaiver.com,your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://appfeewaiver.com,https://www.appfeewaiver.com,https://your-app.onrender.com
# SITE_URL=https://appfeewaiver.com
# DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require
# DB_SSL_REQUIRE=True
# PROFILE_PHOTO_UPLOADS_ENABLED=False      # free hosts have no permanent disk
# REQUIRE_EMAIL_VERIFICATION=False         # set True once SMTP below works

# Optional outgoing email (verification + password reset). Any SMTP provider works,
# e.g. a Gmail account with an App Password (free).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=App Fee Waiver <your-address@gmail.com>

# Development helper: use the Tailwind CDN instead of static/css/tailwind.css
# (only needed if you add new Tailwind classes and don't want to rebuild the CSS).
TAILWIND_USE_CDN=False
