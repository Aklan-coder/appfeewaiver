# Copy this file to `.env` and fill in the values.  NEVER commit `.env` to GitHub.

# --- Local development -------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Leave DATABASE_URL empty to use the local SQLite file (db.sqlite3).
# For PostgreSQL:  postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DB_SSL_REQUIRE=False

# Welcome emails (they contain the WhatsApp link).
#   console = printed in the terminal (local development)
#   brevo   = sent with Brevo's free HTTPS API (use this on Render: its free plan blocks SMTP)
#   smtp    = any SMTP server (EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, EMAIL_USE_TLS)
EMAIL_PROVIDER=console
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=App Fee Waiver <appfeewaiver@gmail.com>

# Secret shared with the Google Apps Script that publishes approved testimonies
# (see docs/GOOGLE_SHEET_SETUP.md). Leave empty to turn syncing off.
TESTIMONY_SYNC_TOKEN=

# --- Production (set these in Render → Environment, not here) ---------------
# DEBUG=False
# SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=appfeewaiver.com,www.appfeewaiver.com,appfeewaiver.onrender.com
# CSRF_TRUSTED_ORIGINS=https://appfeewaiver.com,https://www.appfeewaiver.com,https://appfeewaiver.onrender.com
# SITE_URL=https://appfeewaiver.com
# DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require
# DB_SSL_REQUIRE=True
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
# TESTIMONY_SYNC_TOKEN=<python -c "import secrets; print(secrets.token_urlsafe(32))">

# Development helper: use the Tailwind CDN instead of static/css/tailwind.css
# (only needed if you add new Tailwind classes and don't want to rebuild the CSS).
TAILWIND_USE_CDN=False
